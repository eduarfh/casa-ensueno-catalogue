# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site Configuration
NEXT_PUBLIC_SITE_URL=your_site_url

# Opcional: Deshabilitar source maps en producción
NEXT_DISABLE_SOURCE_MAPS=1

# NOTA: Las credenciales de administración se almacenan en Supabase
# No necesitas configurar variables de entorno para la autenticación admin
# El sistema usa la tabla 'admin_credentials' en tu base de datos
# Credenciales por defecto: admin / admin123 (cámbialas desde el panel)
