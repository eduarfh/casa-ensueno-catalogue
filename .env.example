# Supabase Configuration
SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_BASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_JWT_SECRET=your_jwt_secret
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site Configuration
NEXT_DISABLE_SOURCE_MAPS=1
NEXT_PUBLIC_SITE_URL=your_site_url

# Admin Authentication (SOLO PARA PRODUCCIÓN)
# En desarrollo se usa el archivo .admin-credentials.json automáticamente
# Configura estas variables SOLO cuando despliegues en producción
# Para obtener el ADMIN_PASSWORD_HASH:
# 1. Cambia tu contraseña desde el panel de administración
# 2. El sistema te mostrará las variables de entorno necesarias
# 3. Copia y pega aquí (o en tu plataforma de hosting)
# ADMIN_USERNAME=tu_usuario
# ADMIN_PASSWORD_HASH=tu_hash_generado
