# PostgreSQL Database (Railway)
DATABASE_URL=postgresql://user:password@host:port/database

# Site Configuration
NEXT_PUBLIC_SITE_URL=your_site_url

# Storage Configuration (opcional - configurar cuando decidas qué usar)
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_DEFAULT_REGION=your_region
AWS_S3_BUCKET_NAME=your_bucket
AWS_ENDPOINT_URL=your_endpoint

# Opcional: Deshabilitar source maps en producción
NEXT_DISABLE_SOURCE_MAPS=1

# NOTA: Las credenciales de administración se almacenan en PostgreSQL
# El sistema usa la tabla 'admin_credentials' en tu base de datos
# Credenciales por defecto: admin / admin123 (cámbialas desde el panel)
